# event-stream-platform — environment template.
#
# Copy to .env and adjust. Every value here has a default in internal/platform/config, so
# this file documents what *can* be set rather than what must be. The exceptions are
# DATABASE_URL (required — a process with no database has nothing to do) and
# INGEST_API_KEY (required only when APP_ENV=prod; an unauthenticated ingest endpoint in
# production accepts telemetry from anyone who can reach the port).

# --- process ---
APP_ENV=dev
LOG_LEVEL=info

# --- postgres (sink + deduplication store) ---
# 5433 on the host to avoid colliding with the sibling project's Postgres on 5432.
# Inside the compose network the port is 5432.
DATABASE_URL=postgres://esp:esp@localhost:5433/event_stream?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=1
DB_CONNECT_TIMEOUT=5s

# --- redis (fan-out bus only; never the deduplication store — see ADR-006) ---
# 6380 on the host to avoid colliding with the sibling project's Redis on 6379.
REDIS_URL=redis://localhost:6380/0
REDIS_CHANNEL=telemetry:live

# --- broker (Redpanda, Kafka wire protocol) ---
# 19092 is the EXTERNAL listener, reachable from the host; containers use redpanda:9092.
BROKER_SEEDS=localhost:19092
BROKER_RAW_TOPIC=telemetry.raw.v1
BROKER_DLQ_TOPIC=telemetry.dlq.v1
BROKER_RAW_PARTITIONS=6
BROKER_DLQ_PARTITIONS=3
BROKER_RETENTION=24h
BROKER_DLQ_RETENTION=168h

# --- ingest (HTTP) ---
INGEST_ADDR=:8081
INGEST_MAX_BATCH=500
INGEST_MAX_BODY_BYTES=2097152
INGEST_SHUTDOWN_TIMEOUT=15s
# Required when APP_ENV=prod. Generate with: openssl rand -hex 32
INGEST_API_KEY=

# --- consumer (consumer group member) ---
CONSUMER_GROUP=sink-v1
CONSUMER_METRICS_ADDR=:9091
CONSUMER_BATCH_SIZE=200
CONSUMER_MAX_RETRIES=5
CONSUMER_RETRY_BACKOFF_BASE=250ms
CONSUMER_RETRY_BACKOFF_MAX=30s
CONSUMER_SHUTDOWN_TIMEOUT=30s

# --- gateway (SSE fan-out) ---
GATEWAY_ADDR=:8082
# Per-connection outbound buffer. A client that fills it is disconnected and resyncs from
# the log rather than being allowed to grow the process (ADR-004).
GATEWAY_CLIENT_BUFFER=256
GATEWAY_MAX_CLIENTS=1000
# How far back a reconnecting client may resume. Older than this, it is told to start fresh.
GATEWAY_REPLAY_WINDOW=15m
GATEWAY_SHUTDOWN_TIMEOUT=15s

# --- simulator (deterministic fleet producer) ---
# Emitted by cmd/simulate; it posts the same envelope cmd/ingest accepts, so a real feed
# replaces it by pointing at the same URL (ADR-008).
SIM_SEED=42
SIM_VEHICLES=40
SIM_RATE=20
SIM_INGEST_URL=http://localhost:8081/v1/events
SIM_API_KEY=
